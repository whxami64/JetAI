# Copy to .env and fill in only the provider used by the live runtime.

# Pi model selection. PI_MODEL is intentionally not given a default.
PI_PROVIDER=openai
PI_MODEL=
PI_THINKING_LEVEL=medium

# Provider credentials. Do not fill in or commit credentials for unused providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Runtime limits.
AGENT_MAX_DELEGATION_DEPTH=2
AGENT_MAX_PARALLEL_SUBAGENTS=4
AGENT_MAX_DELEGATED_TASKS=8
AGENT_SUBAGENT_TIMEOUT_MS=120000
AGENT_MAX_RETRIES=1
AGENT_MAX_RESULT_CHARS=20000

# Project-local persistence.
AGENT_SESSION_DIR=.runtime/sessions
AGENT_TRACE_DIR=.runtime/traces

# MCP is opt-in. The checked-in config contains no enabled servers.
AGENT_MCP_ENABLED=false
AGENT_MCP_CONFIG=.config/mcp.json
